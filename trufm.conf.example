# trufm -- ~/.config/trufm/config (or the file $TRUFM_CONFIG names)
#
# A line each: key = value. A # at the start of a line, or " # " after a
# value, begins a comment. Every key is optional; what is left out keeps the
# value shown here. A line trufm cannot read is reported on stderr and
# skipped.
#
# Bookmarks are a file of their own, ~/.config/trufm/places (or under $XDG_CONFIG_HOME), in the same
# form as place = below; b adds the folder you are in, and D on one in the
# places column takes it off again.

# --- files ----------------------------------------------------------------------

hidden = true               # dotfiles in the main column and the preview; . flips it while running
root_hidden = false         # and in the parent column, while hidden is on (the folder you came from always shows)
git = true                 # M + ? U beside the names in a git work tree: changed, staged, new, in conflict

sort = name                 # the main column's order: name | size | date
sort_desc = false           # largest / newest / Z first

confirm_delete = true       # D asks "delete N items for good?" first

# --- layout -----------------------------------------------------------------------

# the columns' widths, in percent of the screen (5 to 50); the main column
# takes what is left
places_width = 15
root_width = 25
preview_width = 20

# a screen narrower than this many columns leaves out the parent column, then
# the preview, then the places (0: always there)
root_min = 130
preview_min = 100
places_min = 70

# --- places -----------------------------------------------------------------------

# the places column, top to bottom: home (key h), the standard places, the
# place = lines below, the bookmarks b added (~/.config/trufm/places, or under $XDG_CONFIG_HOME), and
# the mounted disks. ' and a place's key jumps there from any column

# Desktop (e), Documents (o), Downloads (d), Music (m), Pictures (p),
# Videos (v) -- where ~/.config/user-dirs.dirs puts them, the ones that are
# there -- and / (/)
places.standard = true
places.devices = true       # the DEVICES section

# a place a line: its key (- for none), a space, the path, and if it is to
# be named other than its folder, " | " and the name. A path that is a place
# already gives it this key and name: rekey or rename a standard one so
# place = w ~/work | Work
# place = - /mnt/archive
# place = s ~/Desktop | Desk

# --- opening files ----------------------------------------------------------------

# Enter, l or → on a file opens it (with V: all the chosen files, together);
# o offers every program whose line fits, then xdg-open: 1 to 9 picks one,
# e types a command of your own.
#
# open.<ext>[,<ext>...] = [term:] command
#   The first line that fits wins, then open.*, then xdg-open. A line fits
#   by the file's extension -- or, with a / in it, by its MIME type, as
#   `file --mime-type` says: open.video/* = mpv, open.text/* = ... -- so a
#   README with no extension still finds its editor. term: -- a program that wants the terminal (an editor, a
#   pager): trufm steps aside till it ends; in a window (--gui) it opens in
#   $TERMINAL, or xterm. Any other runs in the background and is left to
#   run. The command goes to sh, so $EDITOR and the like work; %f is where
#   the files go, at the end without it. A file's name never goes into the
#   command's text, so spaces, quotes or $ in a name are safe.
open.txt,md,pl,c,h,py,sh,conf,log = term: ${EDITOR:-vi}
open.pdf,djvu,epub = zathura
open.png,jpg,jpeg,gif,webp,bmp = imv
open.mp4,mkv,webm,avi,mp3,flac,ogg,opus = mpv
open.html = firefox
open.text/* = term: ${EDITOR:-vi}
open.video/*,audio/* = mpv
# open.* = xdg-open

# --- the preview --------------------------------------------------------------------

# highlight = true: trufm colours source files itself, in its own palette
# (PLUM, C/C++, sh, Python, Rust, Go, JS/TS, JSON, TOML/INI/conf, YAML,
# Makefile, Markdown, diffs); a preview. rule for such a file is not used.
# false: the rules below get them, as before. Nothing else changes.
highlight = true

# preview.<ext>[,<ext>...] = [image:] command
#   What the command prints is shown in the preview, colours and all (so a
#   highlighter such as bat shows, for a language trufm does not colour, or
#   with highlight = false). image: -- what it prints is a picture, PNG or
#   PPM. It runs beside trufm, never holding it still, and is killed when the
#   cursor moves on. Rules fit as open. ones do: by extension, or by MIME
#   type (image/*), then preview.*. With none, text and PNG/QOI/PPM show as
#   they are, and anything else as `file` describes it.
# preview.py,md,sh,c,h,rs,go,js,ts,json,toml,yaml,conf,pl = bat --color=always --style=plain --paging=never %f
preview.jpg,jpeg,webp,gif,bmp,tiff,heic,avif = image: magick %f[0] -resize '600x600>' -depth 8 ppm:-
preview.pdf = image: pdftoppm -png -r 40 -f 1 -l 1 %f
preview.mp4,mkv,webm,avi,mov = image: ffmpeg -loglevel error -ss 3 -i %f -frames:v 1 -vf scale=480:-1 -f image2pipe -vcodec png -
preview.zip,tar,gz,xz,bz2,zst,7z,iso = bsdtar -tf %f
preview.audio/* = exiftool %f

# --- unpacking -----------------------------------------------------------------------

# E unpacks the archive under the cursor (or every one chosen with V) as a
# task: always into a new folder named for it -- foo.tar.gz into foo/, or
# foo (2)/ -- and if all it held was one folder or file, that is moved up
# in its place. Without a rule trufm knows tar.*, zip, jar, 7z, iso, cpio,
# deb (by bsdtar), rar (by unrar, where it is), and a lone .gz .bz2 .xz
# .zst .lz4 file (decompressed).
#
# extract.<ext>[,<ext>...] = command   -- run inside the new folder, the
# archive as %f; what it prints, a line an entry, is counted
# extract.rar = unrar x -o- %f
# extract.zip = unzip %f

# --- tabs -------------------------------------------------------------------------

# folders opened as tabs at the start, after the one trufm was started in;
# only on a first run: after it the tabs, hidden and sort of the last run
# come back from ~/.config/trufm/state (delete it to start afresh);
# one line a tab, up to 9 in all; ~ is home; a folder not there is skipped
# tab = ~/Downloads
# tab = ~/Projects

# --- colours ----------------------------------------------------------------------

# #rrggbb. Everything on screen is drawn in these fourteen. Highlighted code
# takes them too: comments dim, strings exec, numbers accent, keywords dir,
# types remote, directives warn, a diff's - error
color.bg = #222222          # the columns
color.bar = #282828         # the title bar
color.cursor = #3a3a3a      # the cursor's row, a tab that is off
color.line = #4e4e4e        # frames, rows chosen with V
color.text = #e4e4e4
color.text2 = #a8a8a8       # a tab that is off
color.dim = #949494         # labels, hidden files, sizes and dates
color.accent = #ffaf00      # focus, titles, the open tab, task bars, VISUAL LINE
color.dir = #87afd7         # folders
color.exec = #87af5f        # files that may be run (a x in their mode)
color.remote = #afaf00
color.warn = #ff8700        # a disk that is nearly full
color.error = #e46c6c       # broken links, failed tasks, delete prompts
color.ink = #222222         # text on the accent
